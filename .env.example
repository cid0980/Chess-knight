# Pusher Channels (ephemeral realtime relay; no database, no stored games)
#
# Create a Channels app, then enable **client events** in its settings: KnightClub
# sends live board snapshots and rematch negotiation as `client-` events on the
# random per-match channel. Without client events, moves never reach the opponent.
#
# The key and cluster are shipped to the browser (NEXT_PUBLIC_*); the secret is
# server-only and must never be renamed to a NEXT_PUBLIC_ variable.
#
# NEXT_PUBLIC_PUSHER_KEY must match PUSHER_APP_KEY.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
#
# Leave everything blank to run in local-only mode: the board still works for
# two-player practice on one device, but friend requests, challenges and online
# games stay unavailable.
